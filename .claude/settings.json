{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session_autopull.sh\"",
            "timeout": 20,
            "statusMessage": "同步 qa-skills repo（自動 git pull）..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session_autopull.sh\" 1800",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/fidelity_gate_stop_hook.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/send_case_fidelity.py\" --infile /tmp/case_fidelity_results.jsonl --purge"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/send_locator_registry.py\" --infile /tmp/locator_results.jsonl --purge"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/send_tool_usage.py\" --infile /tmp/tool_usage.jsonl --purge"
          }
        ]
      }
    ]
  }
}
