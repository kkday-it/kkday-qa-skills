    {
      "id": "search-result-active-tab-web-stage",
      "flow": "things-to-do-search",
      "page": "search-result",
      "component": "active-tab-text",
      "element": "web 結果頁 active tab 文字",
      "semantic": "搜尋結果頁 active tab 的文字，用來驗證自動錨定『門票&體驗』。注意實際 tab 文字是『門票&體驗』（& 全形），非規格寫的『門票/體驗』。active 的關鍵 class token 是 kk-tabs__tab--active，web/mweb 完全相同；『門票&體驗』是資料層文案，程式用文字比對取 active tab，selector 本身不含該字串。",
      "platform": "web",
      "env": "stage",
      "selectors": [
        {"type": "xpath", "value": "//*[contains(@class,'kk-tabs__tab-list')]//*[contains(@class,'kk-tabs__tab--active')]//div[contains(@class,'kk-tabs__tab-text')]", "note": "active tab 文字首選"},
        {"type": "xpath", "value": "//*[contains(@class,'kk-tabs__tab-list')]//div[contains(@class,'kk-tabs__tab-text')]", "note": "全 tab 清單 fallback（再用文字比對挑 active）"}
      ],
      "source": {"case": "KQT-T37931", "origin": "page_object", "ref": "QATest/src/pages/web_playwright/kkday/web/search_result_page.py:24-28"},
      "verify_url": "https://www.stage.kkday.com/zh-tw/search?keyword=%E5%8F%B0%E5%8C%97",
