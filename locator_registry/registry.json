    {
      "id": "ttd-landing-fake-search-trigger-mweb-stage",
      "flow": "things-to-do-search",
      "page": "things-to-do-landing",
      "component": "landing-search-bar-input",
      "element": "mweb landing 假輸入框觸發器",
      "semantic": "mweb landing 頁沒有真實 input，是一個『假輸入框』觸發器。點了會開全域搜尋 modal，且該 modal 容器是 things-to-do-search-discovery（不是共用假設的 search-modal）。",
      "platform": "mweb",
      "env": "stage",
      "selectors": [
        {"type": "css", "value": "div.things-to-do-search-input", "note": "假輸入框容器首選"},
        {"type": "css", "value": ".things-to-do-search-input__text", "note": "內顯示文字（placeholder / 上次關鍵字）"},
        {"type": "css", "value": ".things-to-do-search-input__btn", "note": "搜尋 icon 按鈕（只點 icon 直接送出、不開 modal）"}
      ],
      "source": {"case": "KQT-T37931", "origin": "page_object", "ref": "QATest/src/pages/web_playwright/kkday/mweb/experiences_page.py:9"},
      "verify_url": "https://www.stage.kkday.com/zh-tw/category/global/things-to-do",
