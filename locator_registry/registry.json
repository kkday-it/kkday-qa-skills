    {
      "id": "ttd-search-modal-input-mweb-stage",
      "flow": "things-to-do-search",
      "page": "things-to-do-landing",
      "component": "search-modal-input",
      "element": "mweb 從 landing 觸發的全域搜尋 modal input",
      "semantic": "容器陷阱：header 入口的 modal 容器是 search-modal，但 landing 假輸入框入口的容器是 things-to-do-search-discovery，兩者共用內部元件。KQT-T37931 mweb 第一次 fail 就是因為只假設了 search-modal。首選用 union 同時涵蓋兩種容器。",
      "platform": "mweb",
      "env": "stage",
      "selectors": [
        {"type": "xpath", "value": "//div[contains(@class,'search-modal') or contains(@class,'things-to-do-search-discovery')]//input[contains(@class,'search-input-field__input')]", "note": "雙容器 union 首選（防容器陷阱）"},
        {"type": "xpath", "value": "//div[contains(@class,'things-to-do-search-discovery')]//input[contains(@class,'search-input-field__input')]", "note": "只 landing 入口容器 fallback"}
      ],
      "source": {"case": "KQT-T37931", "origin": "page_object", "ref": "QATest/src/pages/web_playwright/kkday/mweb/search_page.py:13-15"},
      "verify_url": "https://www.stage.kkday.com/zh-tw/category/global/things-to-do",
      "last_verified": "2026-07-09T00:00:00Z",
      "status": "verified"
    },
