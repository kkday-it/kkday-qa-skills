      "component": "landing-search-bar-input",
      "element": "things-to-do landing 頁自帶搜尋框 input",
      "semantic": "things-to-do (門票&體驗) landing 頁『自帶』搜尋框的真實 input。從這裡送出才會自動錨定『門票&體驗』tab；首頁 header 搜尋框不會。page object 註解明確標示為非 header 全域搜尋。",
      "platform": "web",
      "env": "stage",
      "selectors": [
        {"type": "css", "value": "input.things-to-do-search-bar__input", "note": "語意 class 首選"},
        {"type": "xpath", "value": "//input[contains(@class,'things-to-do-search-bar__input')] | //input[contains(@class,'kk-text-field__native') and @type='search'] | //input[contains(@class,'search-input__keyword')]", "note": "結構 fallback union（landing/category 共用元件）"}
      ],
      "source": {"case": "KQT-T37931", "origin": "page_object", "ref": "QATest/src/pages/web_playwright/kkday/web/experiences_page.py:9"},
